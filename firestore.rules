rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Conteúdo curado: qualquer pessoa lê. Só administradores escrevem (painel admin) e o script de seed
    // (firebase-admin ignora estas regras).
    match /countries/{countryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /calls/{callId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Administradores: um documento admins/{uid} por pessoa, criado só pelo console do Firebase.
    // A pessoa só consegue ler o próprio documento (para o app saber se ela é admin).
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Contador de acessos: um documento por dia (stats/AAAA-MM-DD). Qualquer visitante só consegue
    // somar 1 página vista (e no máximo 1 visitante novo) por gravação; só administradores leem.
    match /stats/{day} {
      allow read: if isAdmin();
      allow create: if validDay(day)
        && request.resource.data.keys().hasOnly(statFields())
        && request.resource.data.views == 1
        && request.resource.data.visitors in [0, 1];
      allow update: if validDay(day)
        && request.resource.data.keys().hasOnly(statFields())
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.visitors in [resource.data.visitors, resource.data.visitors + 1];
      allow delete: if false;
    }

    // Dados do usuário: só o próprio dono lê e escreve.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validDay(day) {
      return day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$');
    }

    function statFields() {
      return ['views', 'visitors', 's_inicio', 's_destinos', 's_lugares', 's_cursos', 's_editais',
              's_recursos', 's_sobre', 's_conta', 's_outros'];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Aceita só os campos do modelo, com os tipos esperados.
    function validProfile(data) {
      return data.keys().hasOnly(['goal', 'languages', 'budget', 'roadmap', 'budgetPlan', 'favorites', 'updatedAt'])
        && (!('goal' in data) || data.goal is string)
        && (!('languages' in data) || data.languages is list)
        && (!('budget' in data) || data.budget is string)
        && (!('roadmap' in data) || data.roadmap is map)
        && (!('budgetPlan' in data) || data.budgetPlan is map)
        && (!('favorites' in data) || data.favorites is map);
    }
  }
}
